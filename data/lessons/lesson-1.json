          "number": 1,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "Well, what ",
            " does a typical class ",
            "? (involve)"
          ],
          "answers": [
            "does",
            "involve"
          ]
        },
        {
          "id": "2",
          "number": 2,
          "prompt": "",
          "input": "gaps",
          "segments": [
            "So how many students ",
            " there in a class? (be)"
          ],
          "answers": [
            "are"
          ]
        },
        {
          "id": "3",
          "number": 3,
          "prompt": "",
          "input": "gaps",
          "segments": [
