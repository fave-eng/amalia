    {
      "type": "exercise",
      "id": "u1-grammar-2",
      "title": "2",
      "instructions": "Write questions that you might ask another student at the beginning of a new class.",
      "items": [
        {
          "id": "1",
          "number": 1,
          "prompt": "What / name?",
          "input": "text",
          "answer": "What’s your name?"
        },
        {
          "id": "2",
          "number": 2,
          "prompt": "Where / from?",
          "input": "text",
          "answer": "Where are you from?"
        },
        {
          "id": "3",
          "number": 3,
          "prompt": "What / do?",
          "input": "text",
          "answer": "What do you do?"
        },
        {
          "id": "4",
          "number": 4,
          "prompt": "What / do / when / not work?",
          "input": "text",
          "answer": "What do you do when you’re not working?"
        },
        {
          "id": "5",
          "number": 5,
          "prompt": "How long / study / English?",
          "input": "text",
          "answer": "How long have you studied English?"
        },
        {
          "id": "6",
          "number": 6,
          "prompt": "Why / learn / English?",
          "input": "text",
          "answer": "Why are you learning English?"
        },
        {
          "id": "7",
          "number": 7,
          "prompt": "study / here / before?",
          "input": "text",
          "answer": "Have you studied here before?"
        },
        {
          "id": "8",
          "number": 8,
          "prompt": "meet / the teacher / yet?",
          "input": "text",
          "answer": "Have you met the teacher yet?"
        },
        {
          "id": "9",
          "number": 9,
          "prompt": "What / think of / the test we did?",
          "input": "text",
          "answer": "What do you think of the test we did?"
        },
        {
          "id": "10",
          "number": 10,
          "prompt": "What / go / do / after this class?",
          "input": "text",
          "answer": "What are you going to do after this class?"
        }
      ]
    },
    {
      "type": "exercise",
      "id": "u1-grammar-4",
      "title": "4",
      "instructions": "Nick is thinking of doing a course at an international language centre. Complete his questions to the receptionist. Use the correct form of the verbs in brackets.",
