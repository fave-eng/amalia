    {
      "type": "exercise",
      "id": "u1-conv-6",
      "title": "6",
      "instructions": "Use the questions in the box to complete the conversations. There is one extra question each time.",
      "items": [
        {
          "id": "1",
          "number": 1,
          "prompt": "",
          "input": "select-gaps",
          "layout": "dialogue",
          "segments": [
            "A: Where are you from?\nB: Hungary.\nA: Oh, really? ",
            "\nB: A town called Szeged. Have you heard of it?\nA: No, sorry, I haven’t. Have you studied here before?\nB: No, never.\nA: But your English is really good. ",
            "\nB: About seven years, on and off. But it’s a lot of work, with my degree course, too.\nA: Oh, ",
            "\nB: Medicine.\nA: Really, me too. ",
            "\nB: I’ve just finished my second year."
          ],
          "options": [
            "What year are you in?",
            "How long have you been learning it?",
            "Whose class were you in?",
            "What are you studying?",
            "Whereabouts?"
          ],
          "answers": [
            4,
            1,
            3,
            0
          ]
        },
        {
          "id": "2",
          "number": 2,
          "prompt": "",
          "input": "select-gaps",
          "layout": "dialogue",
          "segments": [
            "A: Hi, again. Did you have a good weekend?\nB: Yes, thanks. It was fun.\nA: ",
            "\nB: I went with my sister to London. She’s over from Italy at the moment. We went shopping.\nA: ",
            "\nB: She bought some presents for everyone at home.\nA: Oh yes. ",
            "\nB: Three sisters and a brother. What about you?\nA: Just one brother.\nB: ",
            "\nA: The same age – in fact we’re twins!"
          ],
          "options": [
            "How many brothers and sisters have you got?",
            "What do they do?",
            "What did you do?",
            "Did you get anything nice?",
            "Older or younger?"
          ],
          "answers": [
            2,
            3,
            0,
            4
          ]
        },
        {
          "id": "3",
          "number": 3,
          "prompt": "",
          "input": "select-gaps",
          "layout": "dialogue",
          "segments": [
            "A: What do you do?\nB: I’m a student, from Argentina. I’m studying Law.\nA: Oh, ",
            "\nB: The University of Buenos Aires.\nA: OK. ",
            "\nB: I want to do international law. What about you?\nA: I’m in computing.\nB: Right. ",
            "\nA: At a programming company in Frankfurt.\nB: So what do you do when you’re not working?\nA: I’m a DJ in a club.\nB: Really? ",
            "\nA: All sorts really – funk, jazz, hip-hop."
          ],
          "options": [
            "What kind of music are you into?",
            "Where are you doing that?",
            "Do you enjoy it?",
            "So why are you studying English?",
            "Where do you work?"
          ],
          "answers": [
            1,
            3,
            4,
            0
          ]
        }
      ]
